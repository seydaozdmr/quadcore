# LLM Provider: "openai" | "anthropic" | "mock"
SPRING_PROFILES_ACTIVE=mock

# OpenAI (required when SPRING_PROFILES_ACTIVE=openai)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (required when SPRING_PROFILES_ACTIVE=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Database (default: H2 in-memory)
# Uncomment for PostgreSQL:
# DB_URL=jdbc:postgresql://localhost:5432/retrodb
# DB_USERNAME=retro
# DB_PASSWORD=retro123
# DB_DRIVER=org.postgresql.Driver

# Similarity Search
SIMILARITY_THRESHOLD=0.78
SIMILARITY_MAX_RESULTS=5
